# Server & Runtime
PORT=5000
NODE_ENV=development

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# Test Database (Must differ from DATABASE_URL; used exclusively by automated tests)
TEST_DATABASE_URL=postgresql://postgres.test:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true
TEST_DIRECT_URL=postgresql://postgres:password@db.test.supabase.co:5432/postgres

# Supabase Storage & Services
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Internal AI Service
AI_SERVICE_URL=http://localhost:8000
INTERNAL_API_KEY=your_shared_internal_api_key_min_32_chars

# Frontend Origin (CORS & Invitations)
FRONTEND_URL=http://localhost:5173

# Authentication Secrets
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_random_string

# Transactional Emails (Resend)
RESEND_API_KEY=re_your_resend_api_key
MAIL_FROM=BrandCheck <onboarding@resend.dev>

# Rate Limiting (Configurable for local testing)
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW_MS=900000
