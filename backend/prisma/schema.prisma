generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  CREATOR
  REVIEWER
}

enum DocumentStatus {
  UPLOADED
  EXTRACTING
  EXTRACTED
  FAILED
}

enum KnowledgeType {
  RULE
  TONE
  TERM_APPROVED
  TERM_BANNED
  FACT
  CLAIM
  VISUAL
  ACCESSIBILITY
  DISCLOSURE
}

enum KnowledgeStatus {
  DRAFT
  APPROVED
  DISABLED
}

enum KnowledgeSource {
  EXTRACTED
  MANUAL
}

enum DraftStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  CHANGES_REQUESTED
}

enum SuggestionSeverity {
  ERROR
  WARNING
  INFO
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  DISMISSED
}

model User {
  id                    String          @id @default(cuid())
  email                 String          @unique
  name                  String
  passwordHash          String
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  memberships           Membership[]
  refreshTokens         RefreshToken[]
  brandDocuments        BrandDocument[]
  createdKnowledgeItems KnowledgeItem[] @relation("CreatedKnowledgeItems")
  approvedKnowledgeItems KnowledgeItem[] @relation("ApprovedKnowledgeItems")
  createdDrafts         Draft[]         @relation("CreatedDrafts")
  reviewedDrafts        Draft[]         @relation("ReviewedDrafts")
  auditEvents           AuditEvent[]
}

model Workspace {
  id             String          @id @default(cuid())
  name           String
  createdById    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  members        Membership[]
  invitations    Invitation[]
  brandDocuments BrandDocument[]
  knowledgeItems KnowledgeItem[]
  drafts         Draft[]
  auditEvents    AuditEvent[]

  @@index([createdById])
}

model Membership {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        Role      @default(CREATOR)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@index([userId])
}

model Invitation {
  id          String    @id @default(cuid())
  workspaceId String
  email       String
  role        Role      @default(CREATOR)
  tokenHash   String    @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, email])
  @@index([tokenHash])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

model BrandDocument {
  id            String          @id @default(cuid())
  workspaceId   String
  uploadedById  String
  fileName      String
  mimeType      String
  sizeBytes     Int
  storagePath   String
  status        DocumentStatus  @default(UPLOADED)
  errorCode     String?
  errorMessage  String?
  extractedText String?
  pageCount     Int?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  workspace     Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedBy    User            @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  knowledgeItems KnowledgeItem[]

  @@index([workspaceId])
  @@index([uploadedById])
  @@index([workspaceId, status])
}

model KnowledgeItem {
  id             String          @id @default(cuid())
  workspaceId    String
  documentId     String?
  type           KnowledgeType
  title          String
  body           String
  status         KnowledgeStatus @default(DRAFT)
  source         KnowledgeSource @default(EXTRACTED)
  sourceQuote    String?
  sourcePage     Int?
  sourceVerified Boolean         @default(false)
  confidence     Float?
  expiresAt      DateTime?
  evidenceUrl    String?
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  workspace      Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  document       BrandDocument?  @relation(fields: [documentId], references: [id], onDelete: SetNull)
  createdBy      User?           @relation("CreatedKnowledgeItems", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy     User?           @relation("ApprovedKnowledgeItems", fields: [approvedById], references: [id], onDelete: SetNull)
  suggestions    DraftSuggestion[]

  @@index([workspaceId, status])
  @@index([workspaceId, type])
  @@index([documentId])
}

model AuditEvent {
  id          String    @id @default(cuid())
  workspaceId String
  actorId     String
  entityType  String
  entityId    String
  action      String
  meta        Json?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User      @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@index([actorId])
}

model Draft {
  id              String            @id @default(cuid())
  workspaceId     String
  creatorId       String
  title           String
  content         String            @db.Text
  status          DraftStatus       @default(DRAFT)
  complianceScore Int?
  reviewedAt      DateTime?
  reviewerId      String?
  reviewNote      String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  workspace       Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator         User              @relation("CreatedDrafts", fields: [creatorId], references: [id], onDelete: Cascade)
  reviewer        User?             @relation("ReviewedDrafts", fields: [reviewerId], references: [id], onDelete: SetNull)
  suggestions     DraftSuggestion[]

  @@index([workspaceId])
  @@index([creatorId])
  @@index([workspaceId, status])
}

model DraftSuggestion {
  id            String             @id @default(cuid())
  draftId       String
  ruleId        String?
  category      String
  severity      SuggestionSeverity @default(WARNING)
  originalText  String             @db.Text
  suggestedText String?            @db.Text
  explanation   String             @db.Text
  status        SuggestionStatus   @default(PENDING)
  createdAt     DateTime           @default(now())
  draft         Draft              @relation(fields: [draftId], references: [id], onDelete: Cascade)
  rule          KnowledgeItem?     @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([draftId])
  @@index([ruleId])
}
